# ===========================
# Composer / dependencias
# ===========================
vendor/
composer.phar
node_modules/

# ===========================
# Configuración local / secretos
# ===========================
.env
.env.*
!.env.example
*.pem
*.key
auth.json

# ===========================
# Cachés, logs y temporales
# ===========================
*.log
logs/
cache/
tmp/
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.php_cs.cache

